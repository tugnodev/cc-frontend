{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "store:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://campus-colobane-backend.onrender.com/*"
        },
        {
          "url": "http://127.0.0.1:3000/*" 
        },
        {
          "url": "https://wellborn-nonhabitually-alfonzo.ngrok-free.dev/*"
        }
      ]
    },
    "websocket:default"
  ]
}
